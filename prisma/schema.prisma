generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?                @map("email_verified")
  image                   String?
  passwordHash            String?                  @map("password_hash")
  isPrivate               Boolean                  @default(false) @map("is_private")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  accounts                Account[]
  sessions                Session[]
  authenticators          Authenticator[]
  watchlists              Watchlist[]
  ratings                 Rating[]
  tvShows                 TvShow[]
  games                   UserGame[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  following               Follow[]                 @relation("UserFollows")
  followers               Follow[]                 @relation("UserFollowedBy")
  watchNextEpisodes       WatchNextEpisode[]

  @@map("users")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   Int
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlists")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  movieId   Int
  rating    Int?
  vote      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("ratings")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique @default(cuid())
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Authenticator {
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id")
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key")
  counter              Int
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

model TvShow {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  tvdbId      Int         @map("tvdb_id")
  tmdbId      Int?        @map("tmdb_id")
  imdbId      String?     @map("imdb_id")
  title       String
  status      String      @default("watching") // watching, completed, plan_to_watch, dropped, not_started_yet
  isFavorite  Boolean     @default(false) @map("is_favorite")
  posterPath  String?     @map("poster_path")
  backdropPath String?    @map("backdrop_path")
  vote         String?     // emotional reaction or rating (e.g. funny, sad, wow, good, etc.)
  rating       Int?        // rating (e.g. 1-10)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes    TvEpisode[]

  @@unique([userId, tvdbId])
  @@map("tv_shows")
}

model TvEpisode {
  id            String    @id @default(cuid())
  showId        String    @map("show_id")
  tvdbId        Int       @map("tvdb_id")
  seasonNumber  Int       @map("season_number")
  episodeNumber Int       @map("episode_number")
  name          String?
  isWatched     Boolean   @default(false) @map("is_watched")
  watchedAt     DateTime? @map("watched_at")
  rewatchCount  Int       @default(0) @map("rewatch_count")
  vote          String?   // emotional reaction or rating (e.g. funny, sad, wow, good, etc.)
  rating        Int?      // rating (e.g. 1-10 or 1-5)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  show          TvShow    @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, seasonNumber, episodeNumber])
  @@map("tv_episodes")
}

model UserGame {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  gameId       Int         @map("game_id")
  title        String
  status       GameStatus  @default(BACKLOG)
  rating       Int?
  review       String?     @db.Text
  posterPath   String?     @map("poster_path")
  backdropPath String?     @map("backdrop_path")
  platforms    String[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("user_games")
}

enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED
}

model MediaGameLink {
  id           String   @id @default(cuid())
  gameId       Int      @map("game_id")
  gameTitle    String   @map("game_title")
  mediaType    String   @map("media_type") // "movie" or "tv"
  mediaId      Int      @map("media_id")   // TMDB / TVDB ID
  mediaTitle   String   @map("media_title")
  confidence   Float    @default(1.0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([gameId, mediaType, mediaId])
  @@map("media_game_links")
}

model WatchNextEpisode {
  id                         String   @id @default(cuid())
  userId                     String   @map("user_id")
  showId                     String   @map("show_id")
  showTitle                  String   @map("show_title")
  tmdbId                     Int      @map("tmdb_id")
  seasonNumber               Int      @map("season_number")
  episodeNumber              Int      @map("episode_number")
  name                       String?
  overview                   String?  @db.Text
  stillPath                  String?  @map("still_path")
  airDate                    String?  @map("air_date")
  remainingCount             Int      @default(0) @map("remaining_count")
  lastWatchedTime            DateTime @map("last_watched_time")
  isNew                      Boolean  @default(false) @map("is_new")
  isFuture                   Boolean  @default(false) @map("is_future")
  daysUntil                  Int      @default(0) @map("days_until")
  totalEpisodesWatched       Int      @default(0) @map("total_episodes_watched")
  totalWatchTimeMinutes      Int      @default(0) @map("total_watch_time_minutes")
  isLastEpisodeOfLastSeason  Boolean  @default(false) @map("is_last_episode_of_last_season")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
  @@map("watch_next_episodes")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
